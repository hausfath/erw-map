# Raw source data: downloaded, derived from, then deleted. Never committed.
data/raw/

# data/interim/ IS committed: the derived layers total ~1.6 MB and let
# build_v0.py run without re-downloading ~1.2 GB of NetCDF. This is the
# "keep derived files small and sufficient to regenerate the figures" rule.
# Includes all four WaterGAP water fluxes (qr, qtot, qs, qsb) so the
# drainage-variable sensitivity in gate 2d runs from a fresh clone.
!data/interim/

# Derived rasters. Large; regenerate with scripts/build_all.sh.
data/processed/*.tif
data/processed/*.vrt
data/processed/*.npy
data/processed/*.npz

# Display tiles. Built by scripts/tiles.py; hosting decided per docs/METHODOLOGY.md.
src/tiles/
*.pmtiles
*.mbtiles

# Google Earth Engine exports land here before local processing.
data/raw/gee/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# macOS
.DS_Store

# Working notes, not part of the reproducible pipeline
to_do.md
scratch/

# Third-party paper: copyrighted, not ours to redistribute. Fetch from the DOI.
# Also covers the RFC note's own PDF, which is regenerated by
# scripts/analysis/make_rfc_report.py.
*.pdf

# TeX build log from that generator. The .tex is committed; the log is not.
docs/*.log

# Verification-report-derived delivery data. Contains per-operator results that
# are not ours to publish. scripts/analyse_deployments.py skips when absent.
cross_deployment_comparison.md
tests/fixtures/deployments_2026.csv
*.docx
